<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Rasputim</AssemblyName>
    <RootNamespace>RasputimDesktop</RootNamespace>
    <ApplicationIcon>Rasputim.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Rasputim Desktop</AssemblyTitle>
    <Description>Aplicativo desktop do Rasputim Cloud Lite</Description>
    <Company>Rasputim</Company>
    <Product>Rasputim Desktop</Product>
    <Version>5.4.0.0</Version>
    <FileVersion>5.4.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
</Project>
